{
  "name": "json-formatter",
  "displayName": "JSON Formatter",
  "description": "Side panel JSON formatter with expand, collapse, and strip-quotes",
  "publisher": "adnin",
  "version": "0.5.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "json-formatter-container",
          "title": "JSON Formatter",
          "icon": "$(bracket-dot)"
        }
      ]
    },
    "views": {
      "json-formatter-container": [
        {
          "type": "webview",
          "id": "jsonFormatter.panel",
          "name": "JSON Formatter"
        }
      ]
    },
    "commands": [
      {
        "command": "jsonFormatter.collapse",
        "title": "JSON Formatter: Collapse (Minify)"
      },
      {
        "command": "jsonFormatter.expand",
        "title": "JSON Formatter: Expand (Pretty Print)"
      },
      {
        "command": "jsonFormatter.stripQuotes",
        "title": "JSON Formatter: Unescape (\\\" → \")"
      }
    ],
    "keybindings": [
      {
        "command": "jsonFormatter.collapse",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-"
      },
      {
        "command": "jsonFormatter.expand",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+="
      },
      {
        "command": "jsonFormatter.stripQuotes",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rifanid98/vs-code-json-formatter"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild src/webview/main.ts --bundle --minify --outfile=media/webview.js --format=iife --target=es2022",
    "watch:webview": "npm run build:webview -- --watch",
    "package": "vsce package",
    "build": "npm run compile && vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2"
  }
}
